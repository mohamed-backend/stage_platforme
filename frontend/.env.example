# ============================================
# Stage Platform - Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
#
# Vite mode-specific files:
#   .env.development  — used during `npm run dev` (Vite dev server)
#   .env.production   — used during `npm run build` (production build)

# API Base URL
# -------------
# VITE_API_URL: Full URL to the backend API including the /api path prefix.
#
# Development: Vite's dev server proxies /api → http://127.0.0.1:8000 automatically
#   so you can use the relative path "/api" and requests will be forwarded.
#
# Production: Set this to the full deployed backend URL.
#   Example: https://api.yourdomain.com/api
#
# VITE_API_URL=/api
