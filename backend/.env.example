# ============================================
# Stage Platform - Backend Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# Django Settings
# ----------------

# SECRET_KEY: Django secret key for cryptographic signing (HMAC, session tokens, CSRF).
# Generate a new one for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_secret_key_here_change_in_production

# DEBUG: Enables debug mode with detailed error pages and development features.
# MUST be False in production. Leaving True in production exposes stack traces and settings.
DEBUG=True

# ALLOWED_HOSTS: Comma-separated list of hostnames the server responds to.
# Use your domain name in production (e.g., "api.yourdomain.com,localhost").
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# ----------------------
# DB_ENGINE: "sqlite3" for development (zero config), "postgresql" for production.
# When using PostgreSQL, set all DB_* variables below.

# DB_ENGINE: Database backend ("sqlite3" or "postgresql")
DB_ENGINE=sqlite3

# DB_NAME: Name of the PostgreSQL database
DB_NAME=stage_platform

# DB_USER: PostgreSQL username
DB_USER=postgres

# DB_PASSWORD: PostgreSQL password (REQUIRED for PostgreSQL, ignored for SQLite)
DB_PASSWORD=your_password

# DB_HOST: PostgreSQL server hostname
DB_HOST=localhost

# DB_PORT: PostgreSQL server port
DB_PORT=5432

# CORS Settings
# --------------
# CORS_ALLOWED_ORIGINS: Comma-separated list of frontend URLs allowed to make API requests.
# Only the listed origins can access the API. Set to your production frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# CORS_ALLOW_ALL_ORIGINS: Allow ALL origins to access the API.
# NEVER enable this in production. It bypasses CORS protection entirely.
CORS_ALLOW_ALL_ORIGINS=False

# Frontend URL
# -------------
# FRONTEND_URL: Base URL of the frontend application.
# Used to generate password reset links sent via email.
FRONTEND_URL=http://localhost:5173

# Email Configuration
# -------------------
# EMAIL_BACKEND: Determines how emails are sent.
#   - "django.core.mail.backends.console.EmailBackend" — Prints emails to console (development)
#   - "django.core.mail.backends.smtp.EmailBackend" — Sends via SMTP server (production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# EMAIL_HOST: SMTP server hostname (required when using smtp backend)
EMAIL_HOST=smtp.example.com

# EMAIL_PORT: SMTP server port (typically 587 for TLS or 465 for SSL)
EMAIL_PORT=587

# EMAIL_USE_TLS: Whether to use TLS encryption for SMTP connections
EMAIL_USE_TLS=True

# EMAIL_HOST_USER: SMTP authentication username (usually your email address)
EMAIL_HOST_USER=your_email@example.com

# EMAIL_HOST_PASSWORD: SMTP authentication password or app-specific password
EMAIL_HOST_PASSWORD=your_email_password

# DEFAULT_FROM_EMAIL: Sender address for outgoing emails (displayed to recipients)
DEFAULT_FROM_EMAIL=Stage Platform <noreply@stage-platform.com>

# SSL Settings (Production)
# -------------------------
# ENABLE_SSL_REDIRECT: When True and DEBUG is False, forces all HTTP requests to HTTPS.
# Also enables secure cookies (session, CSRF) and HSTS headers.
ENABLE_SSL_REDIRECT=False
